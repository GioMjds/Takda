generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// An owner / staff user. Belongs to one tenant, can own/operate many
/// businesses. Auth is JWT; passwords are bcrypt-hashed here.
model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  isActive            Boolean              @default(true)
  password            String
  tenantId            String?
  role                UserRole             @default(Staff)
  deletedAt           DateTime?
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitesSent         Invite[]             @relation("InviteCreator")
  inviteAccepted      Invite?              @relation("InviteAcceptor")
  Appointment         Appointment[]
  AuditLog            AuditLog[]
  Notification        Notification[]
  QueueEntry          QueueEntry[]

  @@index([tenantId])
  @@index([deletedAt])
  @@index([archivedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invite {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  role         UserRole  @default(Staff)
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdById  String
  acceptedById String?   @unique
  createdAt    DateTime  @default(now())

  createdBy  User   @relation("InviteCreator", fields: [createdById], references: [id])
  acceptedBy User?  @relation("InviteAcceptor", fields: [acceptedById], references: [id])
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
}

/// Append-only audit log of meaningful business events ("booking created",
/// "booking cancelled", "walk-in added"). Per AGENTS.md §13 every entry
/// carries the requestId for correlation.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?
  entity      String
  entityId    String?
  action      String
  /// Free-form JSON payload for the event.
  payload     Json?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [actorUserId], references: [id])
}

model Appointment {
  id               BigInt            @id @default(autoincrement())
  patientId        BigInt
  doctorId         BigInt
  appointmentStart DateTime
  appointmentEnd   DateTime
  createdByUserId  String
  status           AppointmentStatus @default(Pending)
  source           AppointmentSource @default(Online)
  reason           String?
  notes            String?
  reminderSent     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  User             User              @relation(fields: [createdByUserId], references: [id])
  Feedback         Feedback?
  Notification     Notification[]
  QueueEntry       QueueEntry?
}

model Feedback {
  id            BigInt       @id @default(autoincrement())
  appointmentId BigInt?      @unique
  patientId     BigInt?
  doctorId      BigInt?
  rating        Int          @db.SmallInt
  comment       String?
  createdAt     DateTime     @default(now())
  Appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model Notification {
  id            BigInt              @id @default(autoincrement())
  patientId     BigInt?
  userId        String
  appointmentId BigInt?
  channel       NotificationChannel
  template      String?
  payload       Json?
  status        NotificationStatus  @default(Pending)
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  Appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  User          User                @relation(fields: [userId], references: [id])
}

model QueueEntry {
  id                   BigInt       @id @default(autoincrement())
  clinicQueueNumber    String
  patientId            BigInt?
  doctorId             BigInt?
  appointmentId        BigInt?      @unique
  queueNumber          Int
  status               QueueStatus  @default(Waiting)
  estimatedWaitMinutes Int?
  origin               QueueOrigin  @default(Walk_in)
  addedByUserId        String
  calledAt             DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime     @default(now())
  User                 User         @relation(fields: [addedByUserId], references: [id])
  Appointment          Appointment? @relation(fields: [appointmentId], references: [id])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  invites   Invite[]
}

enum UserRole {
  Customer
  BusinessOwner
  Staff
}

enum AppointmentSource {
  Online
  Phone
  Walk_in
  Staff
}

enum AppointmentStatus {
  Pending
  Confirmed
  Checked_In
  In_Progress
  Completed
  Cancelled
  No_Show
}

enum Gender {
  Male
  Female
  Other
}

enum NotificationChannel {
  Email
  SMS
  Push
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

enum QueueOrigin {
  Walk_in
  Appointment
  Remote_CheckIn
}

enum QueueStatus {
  Waiting
  Called
  In_Progress
  Completed
  Skipped
  Cancelled
}

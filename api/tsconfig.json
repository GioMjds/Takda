{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "incremental": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "paths": { "@/*": ["./src/*"] },
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
